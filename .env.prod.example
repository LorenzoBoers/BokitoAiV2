# Bokito production env for docker-compose.prod.yml.
# Copy to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
# Then deploy:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# This single file is used both for compose variable substitution
# (--env-file) and injected into the api/worker/web containers (env_file).

# --- Public origin -----------------------------------------------------------
# Host(s) Caddy serves. Space-separate multiple hosts in one BOKITO_DOMAIN value
# (Caddy treats it as a site-address list). Live prod serves bokito.ai +
# app.bokito.ai + api.bokito.ai + *.bokito.ai, all Cloudflare-proxied -> this VPS.
BOKITO_DOMAIN=bokito.ai app.bokito.ai api.bokito.ai *.bokito.ai
# Build label shown in the dashboard login footer.
VITE_APP_VERSION=mvp-1
# Baked into the dashboard SPA at build time (see apps/dashboard/Dockerfile).
# Control-plane (login) host + tenant-subdomain suffix. Defaults already target
# bokito.ai, so these two lines can be omitted for the live bokito.ai setup.
VITE_APP_CONTROL_PLANE_HOST=app.bokito.ai
VITE_TENANT_ROOT_DOMAIN=.bokito.ai
# Platform UI default (`nl` or `en`). API is runtime; VITE_* is baked into the
# web image. Onboarding override: /signup?lang=en or /signup?lang=nl.
PLATFORM_DEFAULT_LANGUAGE=nl
VITE_PLATFORM_DEFAULT_LANGUAGE=nl
# Env-only domain switch (no code change): update VITE_APP_CONTROL_PLANE_HOST +
# VITE_TENANT_ROOT_DOMAIN, add host(s) to BOKITO_DOMAIN, point DNS at the VPS,
# then rebuild the web image (VITE_* is baked at build time):
#   docker compose -f docker-compose.prod.yml build web && up -d web

# --- Registry images (set by CI / scripts/vps-pull-deploy.sh) ----------------
BOKITO_ENV_FILE=.env.prod
BOKITO_API_IMAGE=ghcr.io/lorenzoboers/bokito-api:master
BOKITO_WEB_IMAGE=ghcr.io/lorenzoboers/bokito-web:master-prod
BOKITO_WEB_PORT=8088

# --- Environment / safety ----------------------------------------------------
# Must be "prod" in production: enables fail-fast config checks and Secure cookies.
ENVIRONMENT=prod

# --- Database (in-cluster hostnames) -----------------------------------------
POSTGRES_USER=bokito
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=bokito
DATABASE_URL=postgresql+asyncpg://bokito:CHANGE_ME_strong_db_password@postgres:5432/bokito

# --- Redis (ARQ queue + gateway fanout) --------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth --------------------------------------------------------------------
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_long_random_secret

# Fernet key for OAuth/integration credentials_json (required in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not reuse JWT_SECRET.
CREDENTIALS_FERNET_KEY=CHANGE_ME_fernet_key

# Shared secret between API and worker for inbound processing endpoints.
# Prod validator rejects the default and values shorter than 16 chars.
WORKER_INBOUND_SECRET=CHANGE_ME_strong_worker_secret

# --- CORS --------------------------------------------------------------------
# Dashboard and API are same-origin behind Caddy; list any extra browser
# origins that call the API. Must NOT contain localhost in production.
CORS_ORIGINS=https://bokito.ai,https://app.bokito.ai,https://api.bokito.ai

# --- Smoke-test credentials (GitHub Actions secrets for prod deploy gate) ----
PROD_SMOKE_EMAIL=trader@bokito.ai
# PROD_SMOKE_PASSWORD=set on VPS / GitHub secret only

# --- LLM ---------------------------------------------------------------------
# "live" runs real models; requires ANTHROPIC_API_KEY (chat) and OPENAI_API_KEY (embeddings).
LLM_MODE=live
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Public OAuth origins ----------------------------------------------------
# Must match the Entra/Google/GitHub redirect URI registration:
#   {PUBLIC_API_URL}/api/integrations/oauth/callback
PUBLIC_API_URL=https://app.bokito.ai
PUBLIC_APP_URL=https://app.bokito.ai

# --- Transactional mail (invites, password reset, verification) --------------
# Delivery order: Resend HTTP API -> SMTP -> dev log. Configure RESEND_API_KEY
# (recommended; verify the bokito.ai sending domain in Resend for SPF/DKIM)
# or SMTP so invite/reset/verification links actually reach users. Without a
# provider the API logs a startup warning and mails are log-only.
RESEND_API_KEY=
MAIL_FROM=Bokito <no-reply@bokito.ai>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bokito <no-reply@bokito.ai>
SMTP_USE_TLS=true

# --- Microsoft OAuth (single Entra app, two flows) ----------------------------
# One Entra ID app registration powers BOTH:
#   1. "Sign in with Microsoft" platform SSO (identity scopes:
#      openid email profile User.Read) — GET /api/auth/microsoft/start
#   2. Outlook mailbox connect (delegated Mail.ReadWrite, Mail.Send,
#      offline_access) — started from Settings > Email
# Both flows return through the SAME shared callback, derived from
# PUBLIC_API_URL as {PUBLIC_API_URL}/api/integrations/oauth/callback, so the
# Entra app needs exactly one Web redirect URI:
#   https://app.bokito.ai/api/integrations/oauth/callback
#
# Operator steps to go live:
#   1. Entra admin center > App registrations > New registration
#      - Supported account types: "Accounts in any organizational directory
#        and personal Microsoft accounts" (multitenant + personal = common)
#      - Platform: Web, redirect URI above
#   2. API permissions (Microsoft Graph, delegated): openid, email, profile,
#      User.Read, Mail.ReadWrite, Mail.Send, offline_access. Grant admin
#      consent if the client tenant requires it.
#   3. Certificates & secrets > New client secret; copy the VALUE (not the id).
#   4. Set the vars below on the VPS and restart api+worker:
#        python scripts/ops/vps-set-microsoft-oauth.py
#      (reads MICROSOFT_OAUTH_* from your local env, merges into
#       /opt/bokito/.env.prod, recreates containers)
# When these are empty, SSO start returns 503 and mailbox connect falls back
# to the dev mock flow (dev only; prod refuses mocks).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- WhatsApp Business Cloud API (Meta) ---------------------------------------
# One app-level webhook serves all tenants:
#   {PUBLIC_API_URL}/api/channels/whatsapp/webhook
# META_APP_SECRET signs webhook payloads (X-Hub-Signature-256);
# WHATSAPP_VERIFY_TOKEN answers Meta's subscription handshake.
# Set both or neither (startup validation enforces the pair).
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Email sync (in-process scheduler in api container, ~60s) ----------------
EMAIL_SYNC_ENABLED=true

# --- Bjorn Lunden MCP (Swedish BLA, separate from Dutch KING Accountancy) ----
# Real BL MCP endpoint (streamable HTTP). When set, installing the
# "Bjorn Lunden MCP" integration from the marketplace targets this URL.
# Production refuses mock MCP servers, so this (or an explicit server_url at
# install time) is required before a Swedish BL client can connect.
BJORN_LUNDEN_MCP_URL=

# --- KING Accountancy / KING Finance Cloudswitch (Dutch) ----------------------
# Platform partnerkey from partners@muis.nl. Register the VPS outbound IP
# on this key before go-live (Cloudswitch allowlists callers). Tenants add
# omgevingscodes per administratie in the marketplace form — never a King login.
KING_FINANCE_PARTNER_KEY=
# KING_FINANCE_BASE_URL=https://api.kingfinance.nl/v1/ws1_xml.asmx

# --- Trading MCP (autotrading tenant) ----------------------------------------
# Internal URL on VPS `bokito_shared` Docker network (trading stack).
# TRADING_MCP_URL=http://trading-exec-mcp:8002/mcp
# TRADING_MCP_API_KEY=local-dev-key

# --- Web push (optional) -----------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# --- Observability (optional) -------------------------------------------------
# Sentry error tracking for api + worker. Empty DSN disables Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# JSON log lines are always on when ENVIRONMENT=prod; LOG_JSON=1 forces them elsewhere.
LOG_JSON=
