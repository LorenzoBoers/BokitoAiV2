# Bokito staging env for docker-compose.deploy.yml on the VPS.
# Copy on the server:
#   cp .env.staging.example .env.staging
# Fill secrets, then:
#   docker compose -p bokito-staging --env-file .env.staging \
#     -f docker-compose.deploy.yml -f docker-compose.vps.yml up -d
#
# CI writes BOKITO_API_IMAGE / BOKITO_WEB_IMAGE on each deploy.

BOKITO_ENV_FILE=.env.staging

# --- Registry images (set by CI / scripts/vps-pull-deploy.sh) ----------------
BOKITO_API_IMAGE=ghcr.io/lorenzoboers/bokito-api:master
BOKITO_WEB_IMAGE=ghcr.io/lorenzoboers/bokito-web:master-staging

# --- Public origin -----------------------------------------------------------
BOKITO_DOMAIN=:80
BOKITO_WEB_PORT=8089
VITE_APP_VERSION=staging
VITE_APP_CONTROL_PLANE_HOST=staging.bokito.ai
VITE_TENANT_ROOT_DOMAIN=.bokito.ai

# --- Environment / safety ----------------------------------------------------
ENVIRONMENT=staging

# --- Database (isolated staging volumes) -------------------------------------
POSTGRES_USER=bokito
POSTGRES_PASSWORD=CHANGE_ME_staging_db_password
POSTGRES_DB=bokito_staging
DATABASE_URL=postgresql+asyncpg://bokito:CHANGE_ME_staging_db_password@postgres:5432/bokito_staging

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth (must differ from production) --------------------------------------
JWT_SECRET=CHANGE_ME_staging_jwt_secret

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=https://staging.bokito.ai

# --- LLM (mock by default; flip to live per-tenant via /settings/llm-keys) ---
LLM_MODE=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Smoke-test credentials (seed_staging.py; also set as GitHub secrets) ----
STAGING_SMOKE_EMAIL=trader@staging.bokito.ai
STAGING_SMOKE_PASSWORD=staging-trader-password
