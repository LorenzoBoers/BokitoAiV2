{
  "name": "bokito-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:dashboard": "npm run build:static -w bokito-dashboard",
    "dev:stack": "docker compose -f docker-compose.dev.yml up --build",
    "test:api": "cd apps/api && uv run pytest -q",
    "test:e2e": "playwright test",
    "verify:bokito": "npm run test:api && npm run build:dashboard",
    "verify:bokito:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "expo-font": "55.0.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.34.9"
  }
}
