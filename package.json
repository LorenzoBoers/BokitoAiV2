{
  "name": "bokito-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:dashboard": "npm run build:static -w bokito-dashboard",
    "build:messenger": "npm run build -w bokito-messenger",
    "dev:stack": "docker compose -f docker-compose.dev.yml up --build",
    "test:api": "cd apps/api && uv run pytest -q",
    "test:e2e": "playwright test",
    "verify:bokito": "npm run test:api && npm run build:dashboard && npm run build:messenger",
    "verify:bokito:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
