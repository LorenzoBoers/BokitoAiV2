# Bokito V2 env for docker-compose.v2.deploy.yml on the VPS.
# scripts/vps-v2-bootstrap.sh copies this to .env.v2-staging / .env.v2 and fills the secrets.
# CI (scripts/vps-pull-deploy-v2.sh) rewrites BOKITO_API_V2_IMAGE / BOKITO_WEB_V2_IMAGE on each deploy.

BOKITO_V2_ENV_FILE=.env.v2

# --- Registry images (set by CI) ---------------------------------------------
BOKITO_API_V2_IMAGE=ghcr.io/lorenzoboers/bokito-api-v2:master
BOKITO_WEB_V2_IMAGE=ghcr.io/lorenzoboers/bokito-web-v2:master

# --- Host port for the web container (host Caddy proxies the domain here) -----
# prod 8090 (v2.bokito.ai), staging 8091 (v2-staging.bokito.ai)
BOKITO_V2_WEB_PORT=8090

# --- Environment / safety ----------------------------------------------------
# production requires: JWT_SECRET >= 32 chars, CREDENTIALS_KEY, LLM_MODE=live, REDIS_URL, public PUBLIC_APP_URL
ENVIRONMENT=production
DEBUG=false
LOG_JSON=true

# --- Public origin -----------------------------------------------------------
PUBLIC_APP_URL=https://v2.bokito.ai
PUBLIC_API_URL=https://v2.bokito.ai
CORS_ORIGINS=https://v2.bokito.ai

# --- Database (own volume per compose project) -------------------------------
POSTGRES_USER=bokito
POSTGRES_PASSWORD=CHANGE_ME_v2_db_password
POSTGRES_DB=bokito_v2

# --- Auth and crypto ---------------------------------------------------------
JWT_SECRET=CHANGE_ME_v2_jwt_secret
# Fernet key for connection credentials: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=CHANGE_ME_v2_fernet_key
REDIS_PREFIX=bokito2

# --- Models (EU managed model by default; BYOK per connection) ---------------
LLM_MODE=live
MANAGED_MODEL=mistral:mistral-large-latest
MANAGED_MODEL_REGION=eu
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=mistral:mistral-embed

# --- Channels ----------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Bokito <no-reply@bokito.ai>
INBOUND_DOMAIN=in.bokito.ai
INBOUND_SECRET=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Workbench and modules ---------------------------------------------------
# WORKBENCH_MODE follows LLM_MODE unless set. MODULE_WRITES_ENABLED gates live ledger writes.
WORKBENCH_MODE=
MODULE_WRITES_ENABLED=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
