# Bokito MVP single-origin reverse proxy.
# Serves the built dashboard SPA and proxies /api (REST + WebSocket) to FastAPI.
# TLS certificates are provisioned automatically by Caddy for {$BOKITO_DOMAIN}.

{$BOKITO_DOMAIN} {
	encode zstd gzip

	# MCP OAuth discovery (RFC 8414 / 9728) must hit FastAPI, not the SPA.
	# Cursor fetches these before authorize; HTML here breaks connect with
	# "Unexpected token '<'".
	@oauthWellKnown path /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server* /.well-known/openid-configuration*
	handle @oauthWellKnown {
		reverse_proxy api:8000
	}

	# API + WebSocket gateway -> FastAPI (Caddy upgrades /api/ws automatically).
	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}

	# Webchat widget static bundle (stable filenames, so always revalidate).
	handle_path /chat-widget/* {
		root * /srv/chat-widget
		header Cache-Control "no-cache"
		file_server
	}

	# Dashboard SPA with client-side routing fallback.
	# Hashed build assets are immutable; everything else (index.html, sw.js,
	# logos) must revalidate so a deploy reaches users on the next navigation
	# instead of leaving them on a stale bundle with missing routes/chunks.
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
