# Bokito AI OS API
DATABASE_URL=postgresql+asyncpg://bokito:bokito@localhost:5432/bokito
REDIS_URL=redis://localhost:6379/0
LLM_MODE=mock
JWT_SECRET=dev-jwt-secret-change-in-production
# Optional in dev (falls back to JWT-derived key). Required in production.
# CREDENTIALS_FERNET_KEY=
CORS_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:5175
WORKER_INBOUND_SECRET=dev-worker-secret
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- OAuth providers (integrations + email channels) ---
# Public origins used to build OAuth redirect URIs and post-OAuth returns.
# PUBLIC_API_URL must match the redirect URI registered with each provider:
#   {PUBLIC_API_URL}/api/integrations/oauth/callback
# Leave a provider's client id/secret empty to keep the dev mock flow (no real
# redirect; a local connection is created so the UI still works).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5174

# GitHub OAuth App (github.com → Settings → Developer settings → OAuth Apps)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Google / Gmail (Google Cloud → APIs & Services → Credentials → OAuth client, type Web)
# An OAuth client "Bokito Email Integration" already exists in project bokito-ai;
# add {PUBLIC_API_URL}/api/integrations/oauth/callback to its Authorized redirect URIs.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft / Outlook (Entra ID → App registrations → Web redirect URI + client secret)
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common

# KING Accountancy / KING Finance Cloudswitch (Dutch). Partnerkey is a platform
# secret (never commit real values). Smoke script also reads a test omgevingscode.
# KING_FINANCE_PARTNER_KEY=
# KING_FINANCE_BASE_URL=https://api.kingfinance.nl/v1/ws1_xml.asmx
# KING_FINANCE_TEST_OMGEVINGSCODE=
# KING_FINANCE_TEST_ADM_NAME=
