VITE_XANO_BASE_URL=https://xrex-nmji-j9ur.f2.xano.io
# Same-origin auth contract used by the frontend (handled by proxy/BFF).
VITE_AUTH_PROXY_BASE=/api/auth
# Fallback values when auth responses do not include expires_in.
VITE_DEFAULT_ACCESS_TOKEN_TTL_S=3600
VITE_DEFAULT_REFRESH_TOKEN_TTL_S=2592000

# API group canonicals (Xano group identifiers)
VITE_API_GROUP_APP=app
VITE_API_GROUP_WORKFORCE=workforce
VITE_API_GROUP_LIVECHAT=livechat
VITE_API_GROUP_LOGS=logs
VITE_API_GROUP_BAKERMAT=bakermat

# Public-facing API base URL (used in API docs UI)
VITE_PUBLIC_API_URL=https://api.bokito.nl/v1
