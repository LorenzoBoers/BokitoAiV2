# Required: Base URL for frontend endpoint composition.
# Pattern: {VITE_XANO_BASE_URL} + API group + endpoint path.
VITE_XANO_BASE_URL=https://xrex-nmji-j9ur.f2.xano.io

# Required API group canonicals (Xano group identifiers).
# Keep these aligned with src/lib/api.config.ts.
VITE_API_GROUP_APP=app
VITE_API_GROUP_AUTH=auth
VITE_API_GROUP_INTEGRATIONS=integrations
VITE_API_GROUP_WORKFORCE=workforce
VITE_API_GROUP_LIVECHAT=livechat
VITE_API_GROUP_LOGS=logs
VITE_API_GROUP_BAKERMAT=bakermat

# Optional: Same-origin auth contract used by the frontend (handled by proxy/BFF).
# If the browser console shows 404 on POST /api/auth/refresh, the Xano auth API group
# has no matching refresh route (or uses another path). The app treats 404 as "no refresh"
# and keeps an existing access token in sessionStorage when possible.
VITE_AUTH_PROXY_BASE=/api/auth

# Optional: Fallback values when auth responses do not include expires_in.
VITE_DEFAULT_ACCESS_TOKEN_TTL_S=3600
VITE_DEFAULT_REFRESH_TOKEN_TTL_S=2592000

# Optional: Public-facing API base URL (used in API docs UI).
VITE_PUBLIC_API_URL=https://api.bokito.nl/v1

# Optional: Control-plane + tenant host routing.
# Production defaults:
# - app host: app.bokito.ai
# - tenant hosts: <slug>.bokito.ai
VITE_APP_CONTROL_PLANE_HOST=app.bokito.ai
VITE_TENANT_ROOT_DOMAIN=.bokito.ai

# Optional: local/dev topology defaults:
# - app host: app.localhost:5174
# - tenant hosts: <slug>.localhost:5174
VITE_APP_CONTROL_PLANE_HOST_DEV=app.localhost
VITE_TENANT_ROOT_DOMAIN_DEV=.localhost
VITE_APP_CONTROL_PLANE_URL=http://app.localhost:5174

# Optional: visible build/version label in the UI (login + user menu).
# deploy.ps1 sets this automatically to the Xano build name for deploys.
VITE_APP_VERSION=

# Notes:
# - Add new API groups as VITE_API_GROUP_<NAME> and wire them in src/lib/api.config.ts.
# - Do not put secrets in VITE_* variables; Vite exposes these values to the frontend bundle.
