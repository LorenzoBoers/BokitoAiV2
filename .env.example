# Optional: Cloudflare API token for scripts (Workers deploy / DNS). Used by
# scripts/deploy-cloudflare-app-passthrough.ps1 and scripts/update-cloudflare-app-cname.ps1.
#CLOUDFLARE_API_TOKEN=
# Optional alias read by scripts/deploy-cloudflare-app-passthrough.ps1:
#CF_API_TOKEN=

# Bokito AI OS (Python backend + local dev stack)
# VITE_BOKITO_API_URL=http://127.0.0.1:8000
# DATABASE_URL=postgresql+asyncpg://bokito:bokito@localhost:5432/bokito
# REDIS_URL=redis://localhost:6379/0
# LLM_MODE=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Real Bjorn Lunden MCP endpoint; unset uses the dev mock MCP.
# BJORN_LUNDEN_MCP_URL=

# Transactional mail (invites, password reset, email verification).
# Leave SMTP_HOST empty in dev: mail is logged and auth endpoints return
# dev magic links outside production. PUBLIC_APP_URL is used in mail links.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Bokito <no-reply@bokito.ai>
# SMTP_USE_TLS=true
# PUBLIC_APP_URL=http://localhost:5174

# OAuth provider credentials (leave empty in dev: /oauth/start falls back to
# the mock flow). Redirect URI: {PUBLIC_API_URL}/api/integrations/oauth/callback
# PUBLIC_API_URL=http://127.0.0.1:8000
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
