# Xano Metadata API (static host upload + activate)
XANO_METADATA_API_KEY=
XANO_META_BASE_URL=
# Workspace that owns the static host you deploy to (see Xano → workspace selector).
XANO_WEBSITEWORKSPACE_ID=
# Optional: if the portal lives in another workspace, set this so deploy.ps1 targets the right one.
# If unset, deploy uses XANO_WEBSITEWORKSPACE_ID then XANO_WIDGET_WORKSPACE_ID (legacy).
#XANO_DASHBOARD_WORKSPACE_ID=
# Static host slug in Xano (Settings → Static hosting → host name in the URL), e.g. bokitoapp.
# Must match the host whose build list you check in the UI — not a random label.
XANO_DASHBOARD_STATIC_HOST_NAME=

# Optional: Cloudflare API token for scripts (Workers deploy / DNS). Used by
# scripts/deploy-cloudflare-app-passthrough.ps1 and scripts/update-cloudflare-app-cname.ps1.
#CLOUDFLARE_API_TOKEN=
# Optional alias read by scripts/deploy-cloudflare-app-passthrough.ps1:
#CF_API_TOKEN=
